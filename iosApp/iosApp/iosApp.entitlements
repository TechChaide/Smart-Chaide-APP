<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deja leer el SSID de la red Wi-Fi actual (NEHotspotNetwork.fetchCurrent)
	     sin pedir permiso de ubicacion -- capacidad gratuita, no requiere
	     aprobacion de Apple. Ver Platform.ios.kt / currentWifiSsid(). -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>

<?xml version="1.0" encoding="utf-8"?>
<!-- Luna creciente con destello, igual a las referencias que pidió el
     usuario: resplandor cálido + rayos emergiendo desde la curva interna de
     la media luna, filo de luz en el borde exterior.
     Geometría: círculo A (54,54 r30) menos círculo B (74,54 r36.06), ambos
     pasando por los mismos dos puntos (54,24) y (54,84) — construcción
     estándar de creciente, sin intersección a calcular. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Resplandor cálido detrás de la luna, en la zona que el creciente deja
       expuesta (la mitad derecha de A, cubierta por B) -->
  <path android:pathData="M62,54 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="62" android:centerY="54" android:gradientRadius="22"
          android:startColor="#FFFFF4D6" android:endColor="#00FFF4D6" />
    </aapt:attr>
  </path>

  <!-- Rayos del destello -->
  <path android:pathData="M62,54 L92,54" android:strokeColor="#99FFEFC2" android:strokeWidth="2" android:strokeLineCap="round" android:fillColor="#00000000"/>
  <path android:pathData="M62,54 L95.5,48.1" android:strokeColor="#AAFFF6DC" android:strokeWidth="2.4" android:strokeLineCap="round" android:fillColor="#00000000"/>
  <path android:pathData="M62,54 L85.6,43.0" android:strokeColor="#88FFEFC2" android:strokeWidth="1.6" android:strokeLineCap="round" android:fillColor="#00000000"/>
  <path android:pathData="M62,54 L76.1,37.1" android:strokeColor="#77FFEFC2" android:strokeWidth="1.3" android:strokeLineCap="round" android:fillColor="#00000000"/>
  <path android:pathData="M62,54 L67.2,34.7" android:strokeColor="#66FFEFC2" android:strokeWidth="1.1" android:strokeLineCap="round" android:fillColor="#00000000"/>
  <path android:pathData="M62,54 L80.1,62.5" android:strokeColor="#77FFEFC2" android:strokeWidth="1.3" android:strokeLineCap="round" android:fillColor="#00000000"/>
  <path android:pathData="M62,54 L72.3,66.3" android:strokeColor="#66FFEFC2" android:strokeWidth="1.1" android:strokeLineCap="round" android:fillColor="#00000000"/>

  <!-- Cuerpo de la luna (creciente), oscuro, tapa el resplandor salvo en la
       hendidura interior -->
  <path
      android:pathData="M54,24 A30,30 0 1,0 54,84 A36.06,36.06 0 1,0 54,24 Z"
      android:fillColor="#071D42"/>

  <!-- Filo de luz en el borde exterior de la luna -->
  <path
      android:pathData="M54,24 A30,30 0 1,0 54,84"
      android:strokeWidth="1.6" android:fillColor="#00000000">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:type="linear"
          android:startX="54" android:startY="24"
          android:endX="54" android:endY="84"
          android:startColor="#B38FC2FF" android:endColor="#B3FFC078" />
    </aapt:attr>
  </path>
</vector>
